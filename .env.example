# Copy to .env and fill in. Nothing here is read at import time, so a partial file
# still boots — the API reports what is missing on /healthz.

# --- required for the diagnosis graph ---
ANTHROPIC_API_KEY=
# Voyage powers the retriever's vector arm. Without it the system still runs:
# retrieval falls back to the keyword arm alone.
VOYAGE_API_KEY=

# --- infrastructure ---
# Host port is 5433 in docker compose to avoid clashing with a local Postgres.
DATABASE_URL=postgresql+psycopg://weakspot:weakspot@localhost:5433/weakspot
REDIS_URL=redis://localhost:6379/0

# --- auth ---
ENV=development
# Signs session cookies. The development default is published in this repository, so
# the app refuses to start in production while it is still in place, or if the value is
# under 32 characters. Generate one with: openssl rand -base64 32
SESSION_SECRET=change-me-to-something-random
WEB_ORIGIN=http://localhost:5173
# Blank means lax in development and none in production. The web app and the API run on
# separate hosts in every deployment target here, and a lax cookie is not sent on
# cross-site fetches, so production needs none. Set it to lax only if both end up on
# one registrable domain.
SESSION_COOKIE_SAMESITE=
# Mints a local session without GitHub. The app refuses to start if this is true
# while ENV=production.
DEV_AUTH_BYPASS=true
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8000/api/v1/auth/github/callback

# --- tracing (optional; degrades to a no-op) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
